COMPOSE_PROJECT_NAME=grid-repair
FRONTEND_PORT=20104
BACKEND_PORT=21104
DB_PORT=33060
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_password
JWT_SECRET=local-dev-secret
# 后端本地持久化文件（容器内默认 /app/data/store.json）
DATA_FILE=./data/store.json
# 超时催办规则：重大/紧急报修超过该分钟数未派工即升级并生成待办
ESCALATION_TIMEOUT_MINUTES=15
# 超时扫描周期（毫秒）
DISPATCH_SCAN_INTERVAL_MS=60000
